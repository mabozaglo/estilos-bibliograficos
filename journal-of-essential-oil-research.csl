<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Journal of Essential Oil Research (custom experimental corrected)</title>
    <title-short>JEOR custom corrected</title-short>
    <id>http://www.zotero.org/styles/journal-of-essential-oil-research-custom-corrected</id>
    <link href="http://www.zotero.org/styles/journal-of-essential-oil-research-custom-corrected" rel="self"/>
    <category citation-format="numeric"/>
    <category field="science"/>
    <updated>2026-11-11T00:00:00+00:00</updated>
  </info>
  <macro name="authors">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="never"/>
      <substitute><names variable="editor"/><text variable="title"/></substitute>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <macro name="container">
    <group delimiter=", ">
      <text variable="container-title" font-style="italic"/>
      <text variable="volume"/>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page"/>
    </group>
  </macro>
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="(" suffix=")" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography entry-spacing="0" second-field-align="flush">
    <sort><key variable="citation-number"/></sort>
    <layout>
      <text variable="citation-number" suffix=". "/>
      <group delimiter=". ">
        <text macro="authors"/>
        <text variable="title"/>
        <choose>
          <if type="book">
            <group delimiter=", ">
              <text variable="publisher"/>
              <text variable="publisher-place"/>
            </group>
          </if>
          <else>
            <text macro="container"/>
          </else>
        </choose>
        <text macro="year" prefix="(" suffix=")"/>
      </group>
      <text value="."/>
    </layout>
  </bibliography>
</style>
