<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US" demote-non-dropping-particle="never">
  <info>
    <title>Journal of Essential Oil Research (custom, experimental)</title>
    <title-short>JEOR custom</title-short>
    <id>http://www.zotero.org/styles/journal-of-essential-oil-research-custom-experimental</id>
    <link href="http://www.zotero.org/styles/journal-of-essential-oil-research-custom-experimental" rel="self"/>
    <link href="https://files.taylorandfrancis.com/style_tjeo.pdf" rel="documentation"/>
    <category citation-format="numeric"/>
    <category field="biology"/>
    <summary>Experimental custom CSL based on the Journal of Essential Oil Research Taylor &amp; Francis 2014 style guide. Requires testing before submission.</summary>
    <updated>2026-11-11T00:00:00+00:00</updated>
  </info>
  <macro name="authors">
    <names variable="author">
      <name initialize-with="." delimiter=", " delimiter-precedes-last="never" and="text" sort-separator=" "/>
      <substitute><names variable="editor"/><text variable="title"/></substitute>
    </names>
  </macro>
  <macro name="editors">
    <names variable="editor"><name initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never"/></names>
  </macro>
  <macro name="year">
    <date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date>
  </macro>
  <macro name="pages">
    <text variable="page" form="short"/>
  </macro>
  <macro name="publisher">
    <group delimiter=", "><text variable="publisher"/><text variable="publisher-place"/></group>
  </macro>
  <macro name="reference-body">
    <choose>
      <if type="article-journal article-magazine article-newspaper" match="any">
        <group delimiter=", ">
          <text macro="authors"/>
          <text variable="title"/>
          <text variable="container-title" font-style="italic"/>
          <text variable="volume"/>
          <text macro="pages"/>
          <text macro="year"/>
        </group>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=". ">
          <group delimiter=", "><text macro="authors"/><text variable="title"/></group>
          <group>
            <text value="In: "/>
            <text variable="container-title" font-style="italic"/>
            <group prefix=". Edits., " delimiter=", "><text macro="editors"/></group>
            <group prefix=", pp. "><text macro="pages"/></group>
            <group prefix=", " delimiter=", "><text macro="publisher"/><text macro="year"/></group>
          </group>
        </group>
      </else-if>
      <else-if type="book" match="any">
        <group delimiter=". ">
          <group delimiter=", "><text macro="authors"/><text variable="title" font-style="italic"/></group>
          <group delimiter=", "><text variable="edition" suffix=" edn"/><text macro="publisher"/><text macro="year"/></group>
        </group>
      </else-if>
      <else-if type="thesis" match="any">
        <group delimiter=". ">
          <group delimiter=", "><text macro="authors"/><text variable="title" font-style="italic"/></group>
          <group delimiter=", "><text variable="genre"/><text variable="publisher"/><text variable="publisher-place"/><text macro="year"/></group>
        </group>
      </else-if>
      <else-if type="webpage post-weblog" match="any">
        <group delimiter=". "><group delimiter=", "><text macro="authors"/><text variable="title"/></group><group delimiter=" "><text variable="URL"/><text macro="year"/></group></group>
      </else-if>
      <else>
        <group delimiter=", "><text macro="authors"/><text variable="title"/><text variable="container-title" font-style="italic"/><text macro="publisher"/><text macro="year"/></group>
      </else>
    </choose>
  </macro>
  <citation collapse="citation-number" after-collapse-delimiter=", " delimiter=", ">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="(" suffix=")"><text variable="citation-number"/></layout>
  </citation>
  <bibliography et-al-min="100" et-al-use-first="99" second-field-align="flush" entry-spacing="0" line-spacing="1">
    <sort><key variable="citation-number"/></sort>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="reference-body"/>
    </layout>
  </bibliography>
</style>
