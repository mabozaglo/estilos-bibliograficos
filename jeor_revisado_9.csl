<?xml version='1.0' encoding='UTF-8'?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
 <info><title>JEOR revisado 2026 - version 9</title><title-short>JEOR revisado v9</title-short><id>http://www.zotero.org/styles/jeor-revisado-2026-v9</id><link href="http://www.zotero.org/styles/jeor-revisado-2026-v9" rel="self"/><category citation-format="numeric"/><category field="science"/><updated>2026-11-22T19:44:00+00:00</updated><summary>Custom extended implementation based on Taylor &amp; Francis JEOR style guide dated 15 September 2014.</summary></info>
 <macro name="contributors"><names variable="author"><name initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never"/><substitute><names variable="editor"><name initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never"/></names><text variable="publisher"/><text variable="title"/></substitute></names></macro>
 <macro name="year"><date variable="issued"><date-part name="year"/></date></macro>
 <macro name="publisher-info"><group delimiter=", "><text variable="publisher"/><text variable="publisher-place"/></group></macro>
 <macro name="edition"><choose><if variable="edition" match="any"><group delimiter=" "><number variable="edition" form="ordinal"/><text value="edn"/></group></if></choose></macro>
 <macro name="pages"><text variable="page"/></macro>
 <macro name="online"><choose><if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if><else-if variable="URL"><text variable="URL"/></else-if></choose></macro>
 <citation collapse="citation-number"><sort><key variable="citation-number"/></sort><layout prefix="(" suffix=")" delimiter=", "><text variable="citation-number"/></layout></citation>
 <bibliography entry-spacing="0" second-field-align="flush"><sort><key variable="citation-number"/></sort><layout><text variable="citation-number" suffix=". "/><group delimiter=" "><group delimiter=". "><text macro="contributors"/><choose>
 <if type="thesis"><text variable="title" font-style="italic"/><group delimiter=", "><choose><if variable="genre"><text variable="genre"/></if><else><text value="Thesis"/></else></choose><text variable="publisher"/><text variable="publisher-place"/></group></if>
 <else-if type="book"><group delimiter=", "><text variable="title" font-style="italic"/><text macro="edition"/></group><text macro="publisher-info"/></else-if>
 <else-if type="chapter entry-dictionary entry-encyclopedia"><text variable="title"/><group delimiter=" "><text value="In:"/><text variable="container-title" font-style="italic"/></group><group delimiter=", " prefix=", "><text value="Botanical Series"/><text variable="volume" prefix="vol. "/><text value="parte V"/><text value="n.º 2"/></group><names variable="editor" prefix="Edits., "><name initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never"/></names><group delimiter=", "><text variable="page" prefix="pp. "/><text macro="publisher-info"/></group></else-if>
 <else-if type="article-journal article-magazine article-newspaper"><text variable="title"/><group delimiter=", "><text variable="container-title" font-style="italic"/><group delimiter=""><text variable="volume" font-weight="bold"/><text variable="issue" prefix="(" suffix=")"/></group><text macro="pages"/></group></else-if>
 <else-if type="paper-conference"><text variable="title"/><group delimiter=", "><text variable="container-title" font-style="italic"/><text variable="event"/><text variable="event-place"/><text variable="page" prefix="pp. "/><text macro="publisher-info"/></group></else-if>
 <else-if type="report"><text variable="title" font-style="italic"/><group delimiter=", "><text variable="genre"/><text variable="number"/><text macro="publisher-info"/></group></else-if>
 <else-if type="webpage post post-weblog"><text variable="title"/><text variable="container-title"/><text macro="online"/><date variable="accessed" prefix=". Acceso " form="text"/></else-if>
 <else-if type="dataset software patent legal_case legislation manuscript motion_picture graphic map interview personal_communication speech song broadcast bill"><text variable="title" font-style="italic"/><group delimiter=", "><text variable="genre"/><text variable="number"/><text variable="container-title"/><text macro="publisher-info"/></group></else-if>
 <else><text variable="title"/><group delimiter=", "><text variable="container-title"/><text variable="volume"/><text variable="page"/><text macro="publisher-info"/></group></else>
 </choose></group><group prefix="(" suffix=")"><text macro="year"/></group><choose><if type="article-journal article-magazine article-newspaper"><text variable="URL" prefix=". "/><date variable="accessed" form="text" prefix=". Acceso "/></if></choose></group><text value="."/></layout></bibliography>
</style>
